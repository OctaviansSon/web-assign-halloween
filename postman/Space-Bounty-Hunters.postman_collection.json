            },
            "description": "GET /api/hunts/{id}/ - READ (one)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns the log created above\", function () { pm.expect(String(h.id)).to.eql(pm.collectionVariables.get(\"huntId\")); pm.expect(h.success).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update hunt log (PATCH success + notes)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "description": "PATCH /api/hunts/{id}/ - UPDATE success and notes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Captured after a chase through the rings of Saturn.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"success and notes were updated\", function () { pm.expect(h.success).to.eql(true); pm.expect(h.notes).to.eql(\"Captured after a chase through the rings of Saturn.\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update hunt log (PATCH notes only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "description": "A partial update: only the fields that are sent are changed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Bounty paid out at the Mars office.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"notes changed, success stayed as it was\", function () { pm.expect(h.notes).to.eql(\"Bounty paid out at the Mars office.\"); pm.expect(h.success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "description": "DELETE /api/hunts/{id}/ - DELETE."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () { pm.response.to.have.status(204); });",
                  "pm.test(\"Response body is empty\", function () { pm.expect(pm.response.text()).to.eql(\"\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted hunt log (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "description": "Confirms that the log is really gone."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Error response explains the problem (detail)\", function () { pm.expect(\"detail\" in pm.response.json()).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete second hunt log (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId2}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId2}}",
                ""
              ]
            },
            "description": "Removes the log created by the created_at demonstration."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Invalid requests",
      "description": "Error handling: 404 for ids that do not exist, 422 for malformed or invalid data.",
      "item": [
        {
          "name": "Create hunt log - criminal does not exist (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "description": "Each journal entry must reference an existing criminal.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 999999,\n  \"success\": false,\n  \"notes\": \"There is no such criminal.\"\n}",
