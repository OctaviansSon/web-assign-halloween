# Optional: docker compose works without a .env file (defaults are built in).
# To change something:  cp .env.example .env   (Windows PowerShell: copy .env.example .env)
POSTGRES_USER=bounty
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=bounty

API_PORT=8000
# true = fill an EMPTY database with sample data on startup (8 criminals, 14 hunt logs)
AUTO_SEED=true
